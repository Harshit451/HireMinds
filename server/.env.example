# Server Configuration
PORT=5000

# Client URL for CORS (development / production)
CLIENT_URL=http://localhost:5173

# MongoDB Atlas Connection String
# Format: mongodb+srv://<username>:<password>@<cluster-url>/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/hireminds?retryWrites=true&w=majority

# AI Integration (OpenRouter)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Supabase Configuration (Retained temporarily during migration)
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
